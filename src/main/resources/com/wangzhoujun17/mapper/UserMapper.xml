<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 命名空间必须与 UserMapper 接口全限定名一致 -->
<mapper namespace="com.wangzhoujun17.mapper.UserMapper">

    <!-- 基础 resultMap：显式映射字段，避免开启驼峰映射前的隐式依赖 -->
    <resultMap type="Users" id="usersResult">
        <id     property="id"       column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email"    column="email"/>
    </resultMap>

    <!-- ==================== 修改用户（动态 SQL：set + if） ==================== -->
    <update id="updateUser" parameterType="Users">
        update users
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="email != null and email != ''">
                email = #{email},
            </if>
        </set>
        where id = #{id}
    </update>

    <!-- ==================== 多条件查询（动态 SQL：if + where） ==================== -->
    <select id="findUserByCondition" parameterType="Users" resultMap="usersResult">
        select * from users
        <where>
            <if test="username != null and username != ''">
                and username like concat('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                and email = #{email}
            </if>
        </where>
        order by id
    </select>

    <!-- ==================== 关联查询：一对多 ====================
         一个用户 -> 多个订单
         使用 collection 标签，ofType 指定集合中元素的类型
         ======================================================= -->
    <resultMap type="Users" id="UserWithOrdersResult" extends="usersResult">
        <!-- 使用左连接一次性查出用户及其订单 -->
        <collection property="orderList" ofType="Orders">
            <id     property="id"        column="oid"/>
            <result property="userId"    column="user_id"/>
            <result property="orderDate" column="order_date"/>
        </collection>
    </resultMap>

    <select id="findUserWithOrders" parameterType="int"
            resultMap="UserWithOrdersResult">
        select u.id, u.username, u.password, u.email,
               o.id as oid, o.user_id, o.order_date
        from users u
        left join orders o on u.id = o.user_id
        where u.id = #{id}
        order by o.id
    </select>

</mapper>
